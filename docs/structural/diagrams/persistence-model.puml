@startuml
' Current convention-based runtime model; migration snapshot is older.
hide methods
entity "Smurfs" as SmurfTable {
  * Id : Guid <<PK>>
  --
  * Name : string
  * Age : int
  PetId : Guid? <<FK, indexed>>
  VillageId : Guid? <<shadow FK, indexed>>
}
entity "Pets" as PetTable {
  * Id : Guid <<PK>>
  --
  * Name : string
}
entity "Villages" as VillageTable {
  * Id : Guid <<PK>>
  --
  * Name : string
}
SmurfTable "0..*" --> "0..1" PetTable : PetId
SmurfTable "0..*" --> "0..1" VillageTable : VillageId
note bottom of VillageTable
  Accepted (ADR 0001): optional one-to-many membership.
  Smurfs.VillageId references Villages.Id; NULL = no village.
  VillageId is an EF shadow property, absent from C# Smurf.
  Both optional FKs use ClientSetNull by convention.
end note
note bottom of PetTable
  Needs reconciliation: checked-in migration/snapshot
  still use Pet (singular), omit Villages and VillageId.
  SQLite uses TEXT for Guid/string, INTEGER for Age.
  No migration or database update has been performed.
end note
@enduml

{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "index.md",
          "api-reference.md",
          "_generated/site-pages/**"
        ]
      },
      {
        "src": "_generated/site-pages",
        "files": ["index.md", "api-reference.md"]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "_generated/diagrams/**",
          "structural/diagrams/*.puml",
          "requirements/diagrams/*.puml",
          "engineering/diagrams/*.puml",
          "behavioral/diagrams/*.puml"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Smurfs",
      "_appTitle": "Smurfs",
      "_enableSearch": true,
      "pdf": true
    }
  }
}

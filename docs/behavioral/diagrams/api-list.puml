@startuml
title HTTP API - List Smurfs
actor Operator
participant "JWT bearer authentication" as Auth
participant SmurfsController as Controller
participant MediatR
participant "List.Handler" as Handler
participant "Smurf read service" as Reader
Operator -> Auth : GET /api/smurfs
alt Missing or invalid token
  Auth --> Operator : 401 Unauthorized
else Authenticated
  Auth -> Controller : Dispatch with query parameters
  Controller -> MediatR : Send List.Query
  MediatR -> Handler : Handle query
  alt Invalid paging, infection tokens, or sorting
    Handler --> Controller : Failed result via MediatR
    Controller --> Operator : 400 Bad Request
  else Valid paging
    Handler -> Reader : GetPageAsync
    Reader -> Reader : Apply filters, count, order, then page
    Reader --> Handler : Smurf DTOs and filtered totals
    Handler --> Controller : Successful result via MediatR
    Controller --> Operator : 200 JSON array and Pagination header
  end
end
@enduml

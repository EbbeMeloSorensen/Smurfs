@startuml
title Console setup and use-case dispatch
actor Caller
participant "Console Program" as CLI
participant IAppDataInitializer as Setup
participant NameIsValidRule as NameRule
participant "Create.Handler" as Create
participant IBusinessRuleCatalog as Catalog
participant IUnitOfWork as WriteSession
participant "List.Handler" as List
participant SmurfReadService as ReadService
database "SQLite app data" as DB

Caller -> CLI : initdb, createsmurf or listsmurfs
CLI -> CLI : Check for smurfs.db and configure host
alt initdb or database file missing
  CLI -> Setup : MigrateAsync()
  Setup -> DB : Apply outstanding migrations
  CLI -> Setup : SeedAsync()
  Setup -> DB : Seed sample Smurfs if empty
else listsmurfs with existing database
  CLI -> CLI : Configure SQLite read-only mode
end
alt createsmurf
  CLI -> NameRule : ValidateName(name)
  alt invalid name
    NameRule --> CLI : Violation
  else valid name
    CLI -> CLI : Construct Smurf with age zero
    CLI -> Create : Send command with Smurf
    Create -> Catalog : ValidateAtomic(smurf)
    alt business rule violation
      Create --> CLI : Failure result
    else valid Smurf
      Create -> WriteSession : Stage insert
      Create -> WriteSession : CompleteAsync()
      WriteSession -> DB : Save changes
      Create -> WriteSession : DisposeAsync()
      Create --> CLI : Success
    end
  end
else listsmurfs
  CLI -> List : Send query with paging inputs
  alt nonpositive page or page size
    List --> CLI : Failure result
  else valid paging inputs
    List -> ReadService : GetPageAsync()
    ReadService -> DB : Count rows
    opt requested page starts within count
      ReadService -> DB : Order by Name, then Id and project page
    end
    ReadService --> List : Page and totals
    List --> CLI : Success result
  end
end
CLI --> Caller : Output and exit code
@enduml

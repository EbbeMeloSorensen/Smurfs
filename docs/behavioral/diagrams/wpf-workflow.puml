@startuml
title WPF startup, paging and creation
actor Operator
participant "WPF App" as App
participant "Startup scope (worker)" as Setup
participant IAppDataInitializer as Initializer
participant MainWindowViewModel as ViewModel
participant "Load scope" as Load
participant "List.Handler" as Handler
participant "Create dialog view model" as Dialog
participant IBusinessRuleCatalog as Catalog
participant "Create.Handler" as Create

App -> App : Show splash on UI thread
App -> Setup : Start background initialization
Setup -> Initializer : MigrateAsync(), then SeedAsync()
Setup -> Setup : Dispose scope
alt startup succeeds
  Setup --> App : Initialization completed
  App -> App : Show main window, then close splash
  Operator -> ViewModel : Load smurfs, Previous or Next
  ViewModel -> ViewModel : Disable paging commands
  ViewModel -> Load : Open scope and resolve sender
  Load -> Handler : Send List.Query for requested page
  Handler --> ViewModel : Rows and page metadata, failure or exception
  alt available page or empty catalog
    ViewModel -> ViewModel : Update rows and page indicator
  else request failed or page disappeared
    ViewModel -> ViewModel : Show error, preserve rows
  end
  ViewModel -> Load : Dispose scope
  ViewModel -> ViewModel : Restore command availability
  Operator -> Dialog : New Smurf, enter proposed name
  opt operator selects Save
    Dialog -> Catalog : ValidateAtomic(name draft)
    alt draft is invalid
      Dialog -> Dialog : Show name error and retain draft
    else draft is valid
      Dialog -> Create : Send command with proposed name
      Create -> Catalog : Revalidate draft and entity
      alt creation succeeds
        Create --> Dialog : Success after commit
        Dialog -> ViewModel : Close dialog and refresh page
      else creation fails
        Create --> Dialog : Failure
        Dialog -> Dialog : Show error and retain draft
      end
    end
  end
else startup fails
  Setup --> App : Initialization exception
  App -> App : Report error and shut down
end
@enduml

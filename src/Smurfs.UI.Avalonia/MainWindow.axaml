<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Smurfs.UI.Avalonia.MainWindow"
        xmlns:vm="using:Smurfs.ViewModel"
        xmlns:smurfs="using:Smurfs.Application.Smurfs"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Width="800" Height="450"
        Title="Smurfs.UI.Avalonia">
    <Grid RowDefinitions="Auto,*" Margin="8" RowSpacing="8">
        <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Load smurfs" Command="{Binding LoadSmurfsCommand}"/>
                <Button Content="Previous" Command="{Binding PreviousPageCommand}"/>
                <TextBlock Text="{Binding PageStatus}" VerticalAlignment="Center"/>
                <Button Content="Next" Command="{Binding NextPageCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Smurfs}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="smurfs:SmurfDto">
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>

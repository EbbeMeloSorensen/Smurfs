<Window x:Class="Smurfs.UI.WPF.CreateSmurfDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Smurf" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameInput}">
    <StackPanel Margin="16">
        <Label Content="_Name" Target="{Binding ElementName=NameInput}"/>
        <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Name"/>
        <TextBlock Text="{Binding NameError}" TextWrapping="Wrap" Margin="0,4,0,0"
                   AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="{Binding SaveError}" TextWrapping="Wrap" Margin="0,4,0,0"
                   AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="_Save" IsDefault="True" Command="{Binding SaveCommand}" MinWidth="72" Margin="0,0,8,0"/>
            <Button Content="_Cancel" IsCancel="True" IsEnabled="{Binding CanEdit}" MinWidth="72"/>
        </StackPanel>
    </StackPanel>
</Window>
